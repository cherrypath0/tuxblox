# libadwaita is not fetched by version -- it is the submodule at shared/ui/libadwaita, and the pinned submodule commit is what decides the source
# This value is only the build marker's label, so bump it when the submodule moves to a new upstream release
LIBADWAITA_VERSION=1.7.12-compat1
ADWAITA_FONTS_VERSION=48.2
