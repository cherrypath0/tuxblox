WEBKITGTK_VERSION=2.52.5
# Vendored: libgobject links libffi, and its SONAME differs across distros
# (.so.7 on Debian 11, .so.8 on Ubuntu 22.04/Arch/Fedora).
LIBFFI_VERSION=3.4.6
# Vendored: libsoup links it for HTTP/2 and it is absent on minimal installs.
LIBNGHTTP2_VERSION=1.64.0
GLIB_VERSION=2.84.4
CAIRO_VERSION=1.18.4
PANGO_VERSION=1.56.4
GDK_PIXBUF_VERSION=2.42.12
GTK4_VERSION=4.18.6
LIBSOUP_VERSION=3.6.5
ICU_VERSION=77-1
LIBTASN1_VERSION=4.20.0
SQLITE_YEAR=2026
SQLITE_VERSION=3530400
LCMS2_VERSION=2.17
LIBWEBP_VERSION=1.6.0
OPENJPEG_VERSION=2.5.3
LIBGUDEV_VERSION=237
LIBSECRET_VERSION=0.21.7
LIBDRM_VERSION=2.4.125
MESA_VERSION=25.1.8
LIBTIFF_VERSION=4.7.0
GSTREAMER_VERSION=1.26.5
HARFBUZZ_VERSION=14.3.0
GRAPHENE_VERSION=1.10.8
LIBPSL_VERSION=0.21.5
GMP_VERSION=6.3.0
NETTLE_VERSION=3.10.2
P11KIT_VERSION=0.26.5
GNUTLS_VERSION=3.8.13
GLIB_NETWORKING_VERSION=2.80.1
LIBJPEG_TURBO_VERSION=3.2.0
LIBXML2_VERSION=2.15.3
LIBXSLT_VERSION=1.1.45
FREETYPE_VERSION=2.14.3

# Vendored 3.7.1 to take the bundle off the host's own copies of these. A borrowed
# library brings the host's SONAME and build options with it, which is how the
# libtiff.so.6 and libffi.so.7-vs-.so.8 breakages happened: fine here, unloadable on
# the distros most users run. README.md lists what is still left on the host.
ZLIB_VERSION=1.3.1
BZIP2_VERSION=1.0.8
ZSTD_VERSION=1.5.6
BROTLI_VERSION=1.1.0
EXPAT_VERSION=2.6.4
# Vendored 2026-11-05: pango 1.56.4 requires >= 2.15.0 and Debian 11 carries 2.13.1, so the
# build used to fall through to pango's own fontconfig wrap -- a git clone, which the
# offline build cannot do. It also links freetype, and borrowing the host's copy meant
# linking one built against a different freetype than the 2.14.3 above.
FONTCONFIG_VERSION=2.16.0
# Vendored 2026-11-05. The shipped 3.7.0 bundle already contained libwayland 1.23.0, but
# nothing here built it -- it was copied out of a builder image that had been modified by
# hand, so the library in a published release existed nowhere in this repository. Debian 11
# carries 1.18.0, and gtk4 requires wayland >= 1.23.0 and wayland-protocols >= 1.41 (mesa
# wants that same 1.41), so both are built here now. 1.23.0 is exactly what was shipped and
# exactly what gtk4 asks for; wayland-protocols is build-time data only, no runtime library.
WAYLAND_VERSION=1.23.0
WAYLAND_PROTOCOLS_VERSION=1.41
LIBPNG_VERSION=1.6.44
PCRE2_VERSION=10.44
LIBGPG_ERROR_VERSION=1.50
LIBGCRYPT_VERSION=1.11.0
LIBIDN2_VERSION=2.3.7
FRIBIDI_VERSION=1.0.16
LIBDATRIE_VERSION=0.2.13
LIBTHAI_VERSION=0.1.29
PIXMAN_VERSION=0.44.2
LIBEPOXY_VERSION=1.5.10
LIBGLVND_VERSION=1.7.0
XKBCOMMON_VERSION=1.7.0

# X11 client libraries. The X protocol is stable and these talk to whatever server is
# running, so vendoring them pins our own ABI without pinning the user's display server.
XORGPROTO_VERSION=2024.1
LIBXAU_VERSION=1.0.11
LIBXDMCP_VERSION=1.1.5
XCBPROTO_VERSION=1.17.0
LIBXCB_VERSION=1.17.0
LIBX11_VERSION=1.8.10
LIBXEXT_VERSION=1.3.6
LIBXRENDER_VERSION=0.9.11
LIBXFIXES_VERSION=6.0.1
LIBXDAMAGE_VERSION=1.1.6
LIBXI_VERSION=1.8.2
LIBXRANDR_VERSION=1.5.4
LIBXCURSOR_VERSION=1.2.2
LIBXINERAMA_VERSION=1.1.5
LIBXXF86VM_VERSION=1.1.5
LIBXTST_VERSION=1.2.5
LIBXV_VERSION=1.0.12
LIBXSHMFENCE_VERSION=1.3.2
