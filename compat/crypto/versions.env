# Versions for the crypto libraries the layer links.
#
# Kept in step with compat/webkitgtk/bundle/versions.env on purpose: the webview
# bundle builds the same four, and two different versions of gnutls in one
# install is a confusion nobody needs. Bump both together.
GMP_VERSION=6.3.0
NETTLE_VERSION=3.10.2
LIBTASN1_VERSION=4.20.0
GNUTLS_VERSION=3.8.13
