# webkitgtk-bundle/Containerfile
# Old-glibc-baseline builder image: Debian 12 "bookworm" ships glibc 2.36, old enough
# to cover Ubuntu 22.04+/Debian 12+ and everything newer -- matching the same
# reasoning as the deferred installer/proton GLIBC-floor fix (see project memory
# glibc_floor_installer_bug.md). This container provides build-TIME tools only; the
# base libraries it links against (zlib, libpng, freetype, fontconfig, expat, pixman)
# come from this image's own system packages and are NOT vendored -- see Global
# Constraints in the plan this Containerfile belongs to.
FROM debian:12

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build meson pkg-config git curl ca-certificates \
    ruby gperf unifdef python3 python3-pip patchelf ccache \
    libz-dev libpng-dev libfreetype6-dev libfontconfig1-dev libexpat1-dev \
    libpixman-1-dev libjpeg62-turbo-dev bison flex gettext shared-mime-info \
    libudev-dev libgcrypt20-dev libnghttp2-dev \
    libepoxy-dev libxkbcommon-dev libwayland-dev libwayland-egl-backend-dev \
    wayland-protocols libdrm-dev libtiff-dev libxml2-dev \
    libx11-dev libxext-dev libxrender-dev libxi-dev libxrandr-dev \
    libxcursor-dev libxdamage-dev libxfixes-dev libxinerama-dev \
    libproxy-dev \
    && rm -rf /var/lib/apt/lists/*
# ccache (Task 7 addition): every `podman run` in this whole pipeline uses --rm, so a
# container's entire /build scratch tree -- including every already-compiled .o file
# -- is discarded the moment that run ends, regardless of whether it succeeded or hit
# a real, fixable bug partway through. WebKitGTK alone is ~9400 build targets; without
# ccache, debugging any build-time issue in it means recompiling everything already
# proven to work, every single time, just to reach the untested part again. ccache
# (a compiler output cache keyed on preprocessed source + flags) turns that into a
# near-instant replay for anything unchanged, as long as its cache directory is
# mounted from a persistent volume across runs (see build-in-container.sh's
# CCACHE_DIR / CMAKE_C(XX)_COMPILER_LAUNCHER wiring) -- the same "persist across
# ephemeral containers via a named volume" pattern this script already uses for the
# install prefix itself (webkitgtk-prefix).
# Task 4 (gtk4, libsoup-3, libsecret, libgudev, libpsl) additions, added up front after
# inspecting each project's meson.build/meson.options rather than discovering them one
# failure at a time:
#   - libudev-dev: libgudev's own dependency('libudev', ...) has no required:false --
#     hard build requirement, no auto-detection fallback.
#   - libgcrypt20-dev: libsecret's meson.options 'crypto' option defaults to the combo
#     value 'libgcrypt' (not 'auto'), so dependency('libgcrypt') is unconditionally
#     required unless that option is explicitly overridden. Left at the default rather
#     than disabling crypto -- libsecret's whole purpose is transport-encrypted
#     credential storage, and Roblox's login/cookie persistence is exactly the kind of
#     thing that should go through a real Secret Service backend, not a stripped one.
#   - libnghttp2-dev: libsoup's dependency('libnghttp2') also has no required:false --
#     HTTP/2 support is a hard link-time requirement of libsoup-3, not an optional
#     feature toggle.
#   - libepoxy-dev, libxkbcommon-dev, libwayland-dev, libwayland-egl-backend-dev,
#     wayland-protocols, libdrm-dev, libtiff-dev: all hard, unconditional
#     dependency() calls in gtk4's top-level meson.build (epoxy, xkbcommon when
#     wayland-backend is on, wayland-client/wayland-protocols/wayland-egl when
#     wayland-backend is on, libdrm when building on Linux regardless of backend
#     choice, libtiff for gdk-pixbuf-adjacent image loading).
#   - libx11-dev and friends (xext, xrender, xi, xrandr, xcursor, xdamage, xfixes,
#     xinerama): gtk4's meson.options defaults x11-backend=true and wayland-backend=true
#     (both booleans, not features -- turning either off changes the GDK backend ABI).
#     Building both backends (rather than disabling X11 to dodge these packages) matters
#     because TuxBlox targets arbitrary Linux desktops, many of which are still X11-only
#     or XWayland-dependent; dropping the X11 backend would silently break those users.
#   - libxml2-dev: Debian 12's system libwayland-dev is 1.21.0, older than gtk4
#     4.18.6's stated minimum (wayland-client >= 1.23.0), so meson falls back to
#     building gtk4's bundled `subprojects/wayland.wrap` (upstream wayland 1.23.0,
#     pinned by that wrap file) from source instead -- exactly the kind of
#     old-baseline-container mismatch this whole build already routes around by
#     building most of the stack from source rather than trusting the base distro's
#     versions. That subproject's wayland-scanner enables `dtd_validation` (protocol
#     XML schema validation) by default, which needs libxml-2.0; gtk4's own
#     dependency() call for wayland-client already disables the *separate*
#     `documentation` option via default_options, but not dtd_validation. Installing
#     libxml2-dev satisfies that build-time check with no behavior tradeoff --
#     dtd_validation only validates protocol XML during code generation, it doesn't
#     change anything about the resulting wayland-client library.
#   - libproxy-dev: glib-networking's `libproxy` meson option (its general,
#     cross-desktop proxy auto-detection backend) defaults to the feature value
#     'enabled', not 'auto' -- an unconditional hard requirement unless the
#     package backing it is present. Cheap, ordinary system package (pulls a
#     single runtime lib, libproxy1v5) kept enabled rather than disabled --
#     proxy auto-detection is a real feature a user behind a corporate/system
#     proxy would notice missing, and it resolves whatever the *target*
#     machine's own proxy configuration is at runtime, not anything baked in
#     at build time. (glib-networking's *separate* `gnome_proxy` option, a
#     GNOME/GSettings-specific proxy resolver, is explicitly disabled in
#     build-in-container.sh instead of enabled here -- Debian 12's
#     gsettings-desktop-schemas package ships no .pc file at all, so it can
#     never satisfy that option's pkg-config check on this baseline regardless
#     of whether the apt package is installed; see the comment at that
#     -Dgnome_proxy=disabled flag for why that's an acceptable trim rather
#     than a real functionality loss.)

# Debian 12 bookworm's apt-packaged meson (1.0.1) is too old for GLib 2.84.x, which
# requires meson >= 1.4.0. pip's meson installs to /usr/local/bin, which precedes
# /usr/bin on PATH, so this shadows (without removing) the apt package.
RUN pip3 install --break-system-packages --upgrade 'meson>=1.4.0'

# Task 5 (mesa, wpebackend-fdo) additions:
#   - python3-mako, python3-yaml: mesa's top-level meson.build unconditionally
#     `run_command`s a python snippet that imports both `mako` (>=0.8.0) and `yaml`
#     (PyYAML) and hard-errors if either import fails -- this check runs regardless
#     of which gallium/vulkan drivers are selected, so it's not something
#     `-Dgallium-drivers=softpipe` (our software-only build) can skip. These are
#     Python code-generation tools consumed only at mesa's build time (glsl/NIR
#     codegen etc.), never linked into or shipped inside the runtime .so files, so
#     they belong with the container's other build-time-only tools (ruby, gperf,
#     unifdef) rather than needing to be from-source-vendored into the bundle.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-mako python3-yaml \
    && rm -rf /var/lib/apt/lists/*

# Mesa's X11-platform EGL/GLX path (meson.build ~line 2087 onward) needs the XCB
# protocol bindings directly -- discovered via a real build failure ("Dependency
# xcb-randr not found"), not anticipated in Task 4's X11 package list, which only
# covered Xlib-style libx11/libxext/etc (GTK4's own needs). Mesa additionally talks
# to the X server over XCB for DRI2/DRI3/GLX/present/randr/shm/sync/xfixes, none of
# which Task 4's Xlib packages provide -- XCB and Xlib are separate client library
# families in Debian's packaging even though both talk to the same X server.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libxcb1-dev libx11-xcb-dev libxcb-keysyms1-dev libxcb-dri2-0-dev \
    libxcb-dri3-dev libxcb-glx0-dev libxcb-present-dev libxcb-randr0-dev \
    libxcb-shm0-dev libxcb-sync-dev libxcb-xfixes0-dev \
    libxshmfence-dev \
    && rm -rf /var/lib/apt/lists/*
# libxshmfence-dev: found via a second real build failure one step past the xcb-randr
# one above -- mesa's DRI3 path (mesa/meson.build ~line 2157) additionally needs
# xshmfence (X11's shared-memory fence sync primitive used to synchronize DRI3/Present
# buffer swaps), a separate library from the xcb-* protocol bindings already added.

# gdk-pixbuf's meson.build hard-requires the shared-mime-info package at configure
# time (via pkg-config's shared-mime-info.pc, which ships data/build metadata, not
# a library) -- without it "meson setup" fails with
# "Dependency shared-mime-info not found (tried pkg-config and cmake)". Debian's
# shared-mime-info package installs shared-mime-info.pc to /usr/share/pkgconfig,
# which is on the default pkg-config search path already, so no PKG_CONFIG_PATH
# change is needed -- just installing the package above is enough.

# Task 7 (WebKitGTK itself) additions. Found by reading the REAL Source/cmake/
# OptionsGTK.cmake / WebKitFeatures.cmake / BubblewrapSandboxChecks.cmake in the
# actual webkitgtk-2.52.5 source tree (not guessed from the brief) and cross-checked
# against what actually pkg-config-resolves in the existing webkitgtk-prefix volume,
# same methodology as Tasks 4/5's precedent for expanding the apt package boundary
# when real hard `find_package(... REQUIRED)` / `message(FATAL_ERROR ...)` checks in
# WebKitGTK's own CMake turn up dependencies the plan's Global Constraints list never
# anticipated. All of these are ordinary, stable, near-universally-available Debian
# packages (spell-check/gamepad/sandboxing/logging system integration, not anything
# TuxBlox/WebKitGTK-stack-specific), matching the same class of "system lib" boundary
# Task 4 already established for X11/Wayland/DRM/gcrypt/nghttp2/tiff/udev:
#   - libxxf86vm-dev: a REAL BUG FIX for Mesa (Task 5), not just a Task 7 addition --
#     mesa/meson.build (~line 2167) does an unconditional `dependency('xxf86vm')`
#     (no `required: false`) on the code path taken whenever GLX resolves to 'dri'
#     with direct rendering (the default for an X11-platform build, which Task 5's
#     `-Dplatforms=x11,wayland` selects). Verified directly: re-running Task 5's
#     exact `meson setup` invocation against the real mesa-25.1.8 source with today's
#     Containerfile fails outright with "Dependency xxf86vm not found", and the
#     persistent webkitgtk-prefix volume confirms it -- zero Mesa-produced libraries
#     (no libGL, libEGL, libgbm, libglapi, no DRI driver .so) exist anywhere in the
#     prefix despite Task 5/6's reports claiming a clean `ninja install`. Both facts
#     agree: every "full rerun" since Task 5 was actually failing at the Mesa step
#     under `set -euo pipefail`, and Task 6's later steps that report success (e.g.
#     GStreamer) must have run via its own "fast iteration" scratch invocations
#     against the volume rather than a genuinely clean from-scratch full run, since a
#     mid-script failure would have aborted before ever reaching them. This directly
#     matters for Task 7: WebKitGTK's own OptionsGTK.cmake hard-requires GBM
#     (`-DUSE_GBM` defaults ON, `find_package(GBM)` + `FATAL_ERROR` if missing, and
#     `ENABLE_GPU_PROCESS` itself `WEBKIT_OPTION_DEPEND`s on `USE_GBM`) -- without a
#     working Mesa, WebKitGTK's own configure step would fail the same way.
#   - libmanette-0.2-dev: OptionsGTK.cmake's `ENABLE_GAMEPAD` defaults ON (PUBLIC) and
#     does `find_package(Manette 0.2.4)` + `FATAL_ERROR` if not found -- a real,
#     previously-unlisted hard dependency, not something `-D`-toggleable away without
#     losing the Gamepad API (relevant to Roblox, a game platform).
#   - libenchant-2-dev: `ENABLE_SPELLCHECK` defaults ON, `find_package(Enchant)` +
#     `FATAL_ERROR` if missing. Enchant is a spell-checker *abstraction* layer (it
#     builds/links fine with zero dictionary backends present -- this package alone
#     is sufficient to satisfy WebKitGTK's configure check).
#   - libseccomp-dev, bubblewrap, xdg-dbus-proxy: `ENABLE_BUBBLEWRAP_SANDBOX` defaults
#     ON on Linux. `BubblewrapSandboxChecks.cmake` hard-requires libseccomp
#     (`find_package(Libseccomp)` + `FATAL_ERROR`), plus `find_program(bwrap)` and
#     `find_program(xdg-dbus-proxy)` at CMake-configure time, whose *absolute host
#     paths* get baked in as compile-time `-DBWRAP_EXECUTABLE="..."` /
#     `-DDBUS_PROXY_EXECUTABLE="..."` string literals (not looked up again at
#     runtime). Since apt installs both to the standard `/usr/bin` on Debian --
#     which is also where they'd live on a real target system that has bubblewrap
#     installed, the same FHS path this container itself uses -- the baked-in path
#     should resolve correctly on a real deployment target, unlike the Task 4 ledger's
#     GIO_MODULE_DIR risk (which pointed at this build's own $PREFIX, not a stable
#     system path). Still a real *runtime* dependency worth flagging: WebKit's process
#     sandbox needs bubblewrap + xdg-dbus-proxy actually installed on the end user's
#     machine, the same "assumed present on the target Linux system" boundary Task 4
#     already established for X11/Wayland/DRM -- not something this relocatable
#     prefix vendors or can vendor (they're setuid/namespace-privileged system tools).
#   - libsystemd-dev: `ENABLE_JOURNALD_LOG` defaults ON, `find_package(Journald)` +
#     `FATAL_ERROR` if neither libsystemd nor libelogind is found.
#   - libhyphen-dev: `USE_LIBHYPHEN` defaults ON (PUBLIC), `find_package(Hyphen)` +
#     `FATAL_ERROR` if missing (automatic-hyphenation CSS support).
#   - libxslt1-dev: `ENABLE_XSLT` defaults ON, `find_package(LibXslt 1.1.13 REQUIRED)`
#     -- an ordinary REQUIRED find_package, not gated by a manual FATAL_ERROR check,
#     but just as hard a build requirement. Pairs with the already-apt-installed
#     libxml2-dev (Task 4) the same way upstream libxslt itself depends on libxml2.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libxxf86vm-dev libmanette-0.2-dev libenchant-2-dev libseccomp-dev \
    bubblewrap xdg-dbus-proxy libsystemd-dev libhyphen-dev libxslt1-dev \
    && rm -rf /var/lib/apt/lists/*
# Real, deliberately-scoped-out Task 7 gaps (documented here rather than silently
# built or silently skipped, same style as Task 5's Vulkan-drivers trim and Task 6's
# gst-plugins-good deferral): USE_AVIF (libavif + an AV1 decoder such as dav1d),
# USE_JPEGXL (libjxl + Google's `highway` SIMD dispatch library), and
# ENABLE_SPEECH_SYNTHESIS's USE_FLITE path (CMU Flite, a full offline TTS engine with
# bundled voice data) are all real, default-ON, hard `find_package`+`FATAL_ERROR`
# requirements in WebKitGTK's own OptionsGTK.cmake that have NO graceful "auto"
# fallback (unlike USE_WOFF2, which silently prefers FreeType's own built-in
# brotli-based WOFF2 decoder -- confirmed present in this container's system
# FreeType 2.12.1 by directly compiling WOFF2Checks.cmake's own
# `FT_CONFIG_OPTION_USE_BROTLI` probe -- so libwoff2/brotli were never actually
# needed here). Each of AVIF/JPEG-XL/Flite would be a genuinely new, disproportionately
# heavy from-source dependency chain for a narrow capability (two still-niche modern
# image codecs already largely superseded in practice by the WebP support this bundle
# already has from Task 2, and the rarely-used Web Speech Synthesis API) -- explicitly
# disabled via `-DUSE_AVIF=OFF -DUSE_JPEGXL=OFF -DENABLE_SPEECH_SYNTHESIS=OFF` in
# build-in-container.sh's WebKitGTK cmake invocation rather than silently expanding
# scope further. `-DUSE_LIBBACKTRACE=OFF` is disabled for a different reason: it has
# no tagged upstream release at all (github.com/ianlancetaylor/libbacktrace ships zero
# tags/releases, consumed everywhere else only as a rolling git submodule), which
# can't be pinned the way this whole bundle's versions.env convention requires --
# losing it only degrades the symbol quality of WebKit's own internal crash
# backtraces, a debugging nicety, not a user-facing capability.

WORKDIR /build
RUN mkdir -p /build-scripts
