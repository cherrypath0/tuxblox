# Sniper is Debian 11 (glibc 2.31) with a modern toolchain, matching the floor the rest of TuxBlox is built against.
FROM registry.gitlab.steamos.cloud/steamrt/sniper/sdk:latest

ENV CC=gcc-14 CXX=g++-14

# Bullseye is end of life and its security pool no longer serves the versions the index lists, so only the archive is used
RUN sed -i '/debian-security/d' /etc/apt/sources.list /etc/apt/sources.list.d/* 2>/dev/null || true

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc-14 g++-14 build-essential ninja-build pkg-config git curl ca-certificates \
    python3 python3-pip patchelf ccache cmake nasm \
    libz-dev libpng-dev libjpeg-dev libexpat1-dev libpixman-1-dev \
    libfontconfig1-dev libfribidi-dev libthai-dev libdatrie-dev \
    libx11-dev libxext-dev libxrender-dev libxi-dev libxrandr-dev \
    libxcursor-dev libxdamage-dev libxfixes-dev libxinerama-dev \
    libxcb1-dev libx11-xcb-dev libxcb-render0-dev libxcb-shm0-dev \
    libegl1-mesa-dev libgl1-mesa-dev \
    gettext bison flex shared-mime-info sassc \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --upgrade 'meson>=1.4.0'
