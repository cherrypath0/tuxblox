# Bootstrap entry: installs/updates the per-user ~/.tuxblox tree and hands
# off to the launcher. After the first run the launcher registers its own
# per-user "TuxBlox Launcher" entry, which is the everyday way in.
[Desktop Entry]
Type=Application
Name=TuxBlox Installer
GenericName=Roblox Compatibility Layer
Comment=Install or update TuxBlox in ~/.tuxblox, then launch it
Exec=tuxblox-installer
Icon=tuxblox
Terminal=false
Categories=Game;
Keywords=roblox;studio;wine;proton;
