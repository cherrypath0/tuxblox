pkgbase = tuxblox
	pkgdesc = Roblox Player and Studio on Linux via a custom-patched Proton (per-user install into ~/.tuxblox)
	pkgver = 1.0.0
	pkgrel = 1
	url = https://tuxblox.net
	install = tuxblox.install
	arch = x86_64
	license = GPL-3.0-or-later
	depends = glibc
	depends = gcc-libs
	depends = sdl2
	depends = curl
	depends = libarchive
	depends = openssl
	depends = libglvnd
	depends = xdg-utils
	depends = desktop-file-utils
	optdepends = vulkan-icd-loader: Vulkan runtime used by DXVK to run Roblox
	optdepends = vulkan-radeon: Vulkan driver for AMD GPUs
	optdepends = vulkan-intel: Vulkan driver for Intel GPUs
	optdepends = nvidia-utils: Vulkan driver for NVIDIA GPUs
	options = !strip
	options = !debug
	source = TuxBloxInstaller-1.0.0::https://setup.tuxblox.net/v1/stable/1.0.0/installer
	source = tuxblox.sh
	source = tuxblox.desktop
	source = tuxblox.png
