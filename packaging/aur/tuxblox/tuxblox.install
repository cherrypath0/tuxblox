post_install() {
    cat <<'EOF'
:: TuxBlox installs per-user, exactly like the official installer download:
   run 'tuxblox' (or the "TuxBlox Installer" menu entry). The first run
   downloads ~500 MB into ~/.tuxblox, registers the launcher's own menu
   entry and roblox:// URL handlers, then starts the launcher. From then
   on the per-user install updates itself; this package is only the
   bootstrap.
:: Running Roblox itself needs a working Vulkan driver for your GPU
   (vulkan-radeon / vulkan-intel / nvidia-utils).
EOF
}

post_remove() {
    cat <<'EOF'
:: Per-user data in ~/.tuxblox (including the Wine prefix and any Roblox
   login) was NOT removed, nor were per-user menu entries or roblox:// URL
   handlers. Each user can fully remove theirs with:
       ~/.tuxblox/TuxBloxInstaller --uninstall
EOF
}
